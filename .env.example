PORT=8787
APP_ORIGIN=http://localhost:5173
DATABASE_URL=./data/solarpay.db
# Generate with: openssl rand -base64 32
WALLET_ENCRYPTION_KEY=
# Use a long random authentication secret in shared deployments.
BACKEND_AUTH_SECRET=change-me-in-production
ADMIN_API_KEY=change-me-admin-key
# mock, devnet, or testnet. Devnet is Solana's airdrop-enabled app-development cluster.
SOLANA_MODE=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Public faucets are rate-limited; 0.1 SOL is enough for demo payments and fees.
PAYER_AIRDROP_LAMPORTS=100000000
FEE_RESERVE_LAMPORTS=5000
INTENT_TTL_SECONDS=90

# Optional server-only Supabase registry. Use a secret key, never a browser key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_TABLE=badge_wallets
