{
  "name": "solarpay-badge-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:web": "vite",
    "badge:logs": "node tools/badge-logs.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test",
    "check": "npm test && npm run build",
    "badge:build": "node tools/build-badge-apps.js",
    "badge:install": "node tools/install-badge-app.js",
    "badge:pair": "node tools/install-badge-app.js badges/solarpay_pair.lua",
    "badge:apps": "node tools/install-badge-app.js badges/solarpay_customer.lua badges/solarpay_merchant.lua",
    "badge:backup": "firmware/tools/badge-flash-backup.sh",
    "test:lua": "lua test/splink.test.lua",
    "badge:e2e": "node tools/e2e/run.js",
    "badge:e2e:soak": "node tools/e2e/run.js --loops 5",
    "badge:build:test": "cd firmware/solarpay && idf.py -DSDKCONFIG_DEFAULTS='sdkconfig.defaults;sdkconfig.test' build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.116.0",
    "better-sqlite3": "^12.2.0",
    "express": "^5.1.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.47.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "supertest": "^7.1.4",
    "vite": "^7.1.5"
  }
}
